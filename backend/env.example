# Copy to backend/.env and replace every CHANGE_ME value.
# This file intentionally contains no real credentials.
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Supabase Postgres connection. Keep sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Local AI and RAG defaults.
AI_CLIENT_TYPE=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=60
OLLAMA_THINK=False
RAG_VECTOR_BACKEND=pgvector
EMBEDDING_MODEL=nomic-embed-text
VECTOR_DIMENSION=768

# Optional hosted AI provider.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Production-only examples. Use real public HTTPS origins and hosts.
CSRF_TRUSTED_ORIGINS=https://app.example.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_PROTO=False
USE_X_FORWARDED_HOST=False
